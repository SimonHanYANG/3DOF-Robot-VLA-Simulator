<!-- UR5e pick-and-place scene with parallel jaw gripper -->
<mujoco model="ur5_pickplace_scene">
  <include file="ur5e/ur5e.xml"/>

  <default>
    <default class="table">
      <geom rgba="0.76 0.7 0.65 1" contype="1" conaffinity="1"/>
    </default>
  </default>

  <worldbody>
    <!-- Table surface -->
    <geom name="table" type="box" pos="0.4 0 0.79" size="0.4 0.4 0.02"
          class="table"/>

    <!-- Invisible walls -->
    <geom name="wall_xp" type="box" pos="0.81 0 0.82" size="0.01 0.41 0.03"
          rgba="0 0 0 0" contype="1" conaffinity="1"/>
    <geom name="wall_xn" type="box" pos="-0.01 0 0.82" size="0.01 0.41 0.03"
          rgba="0 0 0 0" contype="1" conaffinity="1"/>
    <geom name="wall_yp" type="box" pos="0.4 0.41 0.82" size="0.42 0.01 0.03"
          rgba="0 0 0 0" contype="1" conaffinity="1"/>
    <geom name="wall_yn" type="box" pos="0.4 -0.41 0.82" size="0.42 0.01 0.03"
          rgba="0 0 0 0" contype="1" conaffinity="1"/>

    <!-- Gripper body (welded to wrist_3_link) -->
    <body name="gripper_base" pos="0 0 0">
      <freejoint/>
      <site name="gripper_weld_site" pos="0 0 0" size="0.002" rgba="1 0 0 0.5"/>
      <!-- Wrist camera (facing -Z in gripper frame = approach direction) -->
      <camera name="wrist_cam" pos="0.03 0.02 -0.04" xyaxes="0 -1 0 0 0 -1" fovy="70"/>

      <!-- Palm -->
      <geom name="palm_geom" type="box" size="0.015 0.025 0.008"
            rgba="0.3 0.3 0.35 1" contype="0" conaffinity="0"/>

      <!-- Left finger (+X direction) -->
      <body name="finger_left" pos="0.005 0 -0.025">
        <joint name="finger_left_joint" type="slide" axis="1 0 0"
               range="0 0.045" damping="5"/>
        <geom name="finger_left_geom" type="box" size="0.004 0.008 0.02"
              rgba="0.3 0.3 0.35 1" friction="5.0 0.01 0.005"
              contype="1" conaffinity="1"/>
      </body>

      <!-- Right finger (-X direction) -->
      <body name="finger_right" pos="-0.005 0 -0.025">
        <joint name="finger_right_joint" type="slide" axis="-1 0 0"
               range="0 0.045" damping="5"/>
        <geom name="finger_right_geom" type="box" size="0.004 0.008 0.02"
              rgba="0.3 0.3 0.35 1" friction="5.0 0.01 0.005"
              contype="1" conaffinity="1"/>
      </body>
    </body>

    <!-- Objects (sized for gripper with fingers at ±0.01) -->
    <body name="obj_cube" pos="0.3 0.1 0.842">
      <freejoint/>
      <geom name="cube_geom" type="box" size="0.03 0.03 0.03"
            rgba="0.9 0.2 0.2 1" mass="0.002" friction="5.0 0.01 0.005"/>
    </body>

    <body name="obj_sphere" pos="0.5 -0.1 0.845">
      <freejoint/>
      <geom name="sphere_geom" type="sphere" size="0.035"
            rgba="0.2 0.8 0.2 1" mass="0.05" friction="5.0 0.01 0.005"/>
    </body>

    <body name="obj_cylinder" pos="0.4 0.2 0.85">
      <freejoint/>
      <geom name="cylinder_geom" type="cylinder" size="0.025 0.05"
            rgba="0.2 0.2 0.9 1" mass="0.05" friction="5.0 0.01 0.005"/>
    </body>

    <!-- Target marker -->
    <site name="target_marker" pos="0.5 0 0.82" size="0.015"
          rgba="1 1 0 0.5" type="sphere"/>

    <!-- Cameras -->
    <body name="table_center" pos="0.4 0 0.8">
      <geom size="0.001" rgba="0 0 0 0" contype="0" conaffinity="0"/>
    </body>
    <camera name="top_cam" pos="0.4 0 1.5" target="table_center" fovy="60"/>
  </worldbody>

  <equality>
    <weld site1="attachment_site" site2="gripper_weld_site" solref="0.0001 1" solimp="0.99 0.999 0.001"/>
  </equality>

  <actuator>
    <!-- Gripper actuators (two separate, command symmetrically from Python) -->
    <position name="gripper_left" joint="finger_left_joint"
              kp="50" ctrlrange="0 0.045"/>
    <position name="gripper_right" joint="finger_right_joint"
              kp="50" ctrlrange="0 0.045"/>
  </actuator>

</mujoco>
