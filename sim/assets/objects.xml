<!-- Pushable objects: sphere, cube, cone -->
<default>
  <default class="push_obj">
    <geom mass="0.08" friction="0.8 0.01 0.01"/>
    <joint type="free" damping="2.0 2.0 2.0 5.0 5.0 5.0"/>
  </default>
</default>

<!-- Red sphere (radius=0.02m) -->
<body name="obj_sphere" pos="0 0 0.03">
  <freejoint/>
  <geom name="sphere_geom" type="sphere" size="0.02"
        rgba="0.9 0.2 0.2 1" mass="0.05" friction="0.8 0.01 0.01"/>
</body>

<!-- Blue cube (0.04m side) -->
<body name="obj_cube" pos="0.1 0.1 0.03">
  <freejoint/>
  <geom name="cube_geom" type="box" size="0.02 0.02 0.02"
        rgba="0.2 0.2 0.9 1" mass="0.08" friction="0.8 0.01 0.01"/>
</body>

<!-- Green cone (base_r=0.02m, h=0.04m) -->
<body name="obj_cone" pos="-0.1 0.1 0.03">
  <freejoint/>
  <geom name="cone_geom" type="cone" size="0.02 0.04"
        rgba="0.2 0.8 0.2 1" mass="0.06" friction="0.8 0.01 0.01"/>
</body>
